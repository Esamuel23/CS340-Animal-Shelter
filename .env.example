# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- App (required) ---------------------------------------------------------
# Least-privilege user (custom role: find/insert/update/remove on aac.animals).
# Atlas example shape: mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB=aac
MONGO_COLLECTION=animals
# Server selection / connect timeout in ms (100-60000)
MONGO_TIMEOUT_MS=5000

# --- Setup scripts (setup_db.py, explain_report.py) ---------------------------
# A separate user with readWrite + dbAdmin on the aac database only.
# If empty, the scripts fall back to MONGO_URI (which will lack index rights).
MONGO_SETUP_URI=

# --- Integration tests (a separate TEST database, never aac) -----------------
MONGO_TEST_URI=
MONGO_TEST_APP_URI=
MONGO_TEST_DB=aac_test

# --- Local mongod only: scripts/create_local_users.py ------------------------
MONGO_ADMIN_URI=
SHELTER_APP_PASSWORD=
SHELTER_SETUP_PASSWORD=

# --- Dashboard ---------------------------------------------------------------
DASH_HOST=127.0.0.1
DASH_PORT=8050
# 1 shows tracebacks in the browser. Leave 0 outside local debugging.
DASH_DEBUG=0

# --- Employer portal (stretch) -----------------------------------------------
PORTAL_ENABLED=0
# 1 = cookie only sent over HTTPS (browsers also allow it on http://localhost).
PORTAL_SECURE_COOKIE=1
